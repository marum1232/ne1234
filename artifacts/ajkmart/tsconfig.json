{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/constants/*": ["./constants/*"],
      "@workspace/*": [
        "../../node_modules/.pnpm/node_modules/@workspace/*/dist"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "references": [
    {
      "path": "../../lib/api-client-react"
    },
    {
      "path": "../../lib/auth-react"
    }
  ]
}
