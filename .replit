modules = ["nodejs-20", "python-3.11"]

# --- DEPLOYMENT SETTINGS ---
[deployment]
run = ["pnpm", "start"]
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# --- NIX CONFIG (Strict Mode) ---
[nix]
channel = "stable-24_05"
guessImports = false     # Isse Replit khud se kachra workflows nahi banayega

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 5173

[[ports]]
localPort = 3004
externalPort = 8008

[[ports]]
localPort = 3005
externalPort = 6000

[[ports]]
localPort = 3006
externalPort = 5000

[[ports]]
localPort = 3007
externalPort = 6800

[[ports]]
localPort = 3008
externalPort = 8000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 20716
externalPort = 8080

[[ports]]
localPort = 20717
externalPort = 3003

# --- ENVIRONMENT CONFIG ---
