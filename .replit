modules = ["nodejs-20", "python-3.11", "postgresql-16"]

# --- DEPLOYMENT SETTINGS ---
[deployment]
run = ["pnpm", "start"]
deploymentTarget = "autoscale"
build = ["pnpm", "build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# --- NIX CONFIG (Strict Mode) ---
[nix]
channel = "stable-24_05"
guessImports = false     # Isse Replit khud se kachra workflows nahi banayega

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rider App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Admin App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Vendor App"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Rider App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/rider-app run dev"
waitForPort = 3002

[[workflows.workflow]]
name = "Admin App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/admin run dev"
waitForPort = 3001

[[workflows.workflow]]
name = "Vendor App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/vendor-app run dev"
waitForPort = 3003

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3000

[[ports]]
localPort = 3006
externalPort = 5000

[[ports]]
localPort = 5000
externalPort = 8008

[[ports]]
localPort = 5001
externalPort = 4200

[[ports]]
localPort = 5002
externalPort = 8081

[[ports]]
localPort = 20716
externalPort = 8080

[[ports]]
localPort = 20717
externalPort = 3003

# --- ENVIRONMENT CONFIG ---
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[userenv.shared]
VITE_API_PROXY_TARGET = "http://127.0.0.1:5000"
NODE_ENV = "production"
PORT = "5000"
RIDER_DEV_PORT = "3002"
EXPO_DEV_PORT = "20716"
JWT_ISSUER = "ajkmart-dev"
ADMIN_SEED_EMAIL = "admin@ajkmart.com"
ADMIN_SEED_NAME = "Super Admin"
